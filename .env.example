# 轻小说对话辅助阅读器：示例配置
#
# 用法（可选，全部都有默认值）：
#   1) 复制成仓库根目录的 .env：Copy-Item .env.example .env
#   2) 按需取消注释并修改
#   3) 重启服务生效（scripts\dev.ps1、scripts\serve.ps1 或 python -m ndr 都会读取根目录 .env）
#
# 安全约定：**本文件不存放任何密钥**。模型密钥请在界面「模型配置」里填写，
# 由后端写入系统凭据库（keyring）或进程内会话；`.env`、数据库、日志与导出件里都没有密钥明文。
# `.env` 已被 .gitignore 忽略，不会被提交。

# ---- 服务与数据目录 ----
# NDR_ENVIRONMENT=local
# NDR_HOST=127.0.0.1
# NDR_PORT=8765
# 只允许这些来源跨域访问 API（开发前端默认端口）；JSON 数组形式
# NDR_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 数据目录：书籍原文、SQLite、导出成品与日志都在这里；升级前请先备份
# NDR_DATA_DIR=F:\Code\novel-dialogue-reader\data
# 启动时自动迁移（默认 0：由 dev.ps1 / serve.ps1 或 alembic 显式执行）
# NDR_AUTO_MIGRATE=0
# 生产同源启动：把前端构建产物挂在后端同一端口（serve.ps1 会自动设置）
# NDR_STATIC_DIR=F:\Code\novel-dialogue-reader\frontend\dist

# ---- 凭据 ----
# system = 系统凭据库（默认）；session = 只用进程内会话密钥（临时/演示用，重启即失效）
# NDR_CREDENTIAL_BACKEND=system

# ---- 模型调用与恢复 ----
# NDR_LLM_TIMEOUT_SECONDS=30
# NDR_RATE_LIMIT_MAX_RETRIES=2
# NDR_RATE_LIMIT_BACKOFF_BASE_SECONDS=1
# NDR_RATE_LIMIT_BACKOFF_MAX_SECONDS=30
# NDR_STALE_RUN_LEASE_SECONDS=900
# NDR_RECOVER_ON_STARTUP=1

# ---- 导入与 EPUB 限制 ----
# NDR_MAX_IMPORT_BYTES=52428800
# NDR_MAX_EPUB_ENTRIES=2000
# NDR_MAX_EPUB_TOTAL_UNCOMPRESSED_BYTES=209715200
# NDR_MAX_EPUB_ENTRY_BYTES=33554432
# NDR_MAX_EPUB_SPINE_ITEMS=1000

# ---- 仅离线演示/验收：测试用假提供方（不发网络请求，**不代表真实模型能力**）----
# NDR_ALLOW_FAKE_PROVIDER=0
# NDR_FAKE_PROVIDER_LABELS=unknown
